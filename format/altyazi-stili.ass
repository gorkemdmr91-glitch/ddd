[Script Info]
; Mistanbul Döner röportaj formatı — altyazı stil şablonu
; Hedef: 1080x1920 (9:16). 720x1280 için punto/margin değerlerini /1.5 yap.
; Kullanım: ffmpeg -i ham.mp4 -vf "ass=altyazi-stili.ass" -c:a copy cikti.mp4
; Gerekli font: Montserrat ExtraBold  (apt: fonts-montserrat)
; Not: libass yuvarlatılmış köşe desteklemez — kutular köşeli çıkar.
;      Birebir görünüm için CapCut kullan.
ScriptType: v4.00+
PlayResX: 1080
PlayResY: 1920
WrapStyle: 0
ScaledBorderAndShadow: yes
YCbCr Matrix: TV.709

[V4+ Styles]
; ASS renk formatı: &HAABBGGRR (alpha, blue, green, red) — RGB'nin TERSİ
; BorderStyle=3 + Outline>0 => metnin arkasına kutu çizer, kutu rengi = OutlineColour
; Alpha 40 = ~%75 opak, 00 = tam opak
Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding

; Ana altyazı — beyaz metin, %75 opak siyah kutu, alt-orta hizalı
Style: Altyazi,Montserrat ExtraBold,63,&H00FFFFFF,&H00FFFFFF,&H40151215,&H00000000,0,0,0,0,100,100,0,0,3,11,0,2,90,90,567,1

; Konuşmacı etiketi — host (amber #F5AF0E -> &H000EAFF5), siyah yazı, sol-alt
Style: ChipHost,Montserrat ExtraBold,33,&H00000000,&H00000000,&H000EAFF5,&H00000000,0,0,0,0,100,100,0,0,3,9,0,1,95,90,717,1

; Konuşmacı etiketi — misafir (mercan #E75F5A -> &H005A5FE7), beyaz yazı, sol-alt
Style: ChipMisafir,Montserrat ExtraBold,33,&H00FFFFFF,&H00FFFFFF,&H005A5FE7,&H00000000,0,0,0,0,100,100,0,0,3,9,0,1,95,90,717,1

[Events]
Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text

